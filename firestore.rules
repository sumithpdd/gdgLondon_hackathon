rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // App error log (Admin SDK / API routes only)
    match /error_logs/{id} {
      allow read, write: if false;
    }

    function getUserRole(userId) {
      return exists(/databases/$(database)/documents/io2026Hackathon_users/$(userId))
        ? get(/databases/$(database)/documents/io2026Hackathon_users/$(userId)).data.role
        : get(/databases/$(database)/documents/hackatonUsers/$(userId)).data.role;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    /** Admin if either user collection marks the signed-in uid as admin (IO doc must not shadow legacy admin). */
    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/io2026Hackathon_users/$(request.auth.uid))
          && get(/databases/$(database)/documents/io2026Hackathon_users/$(request.auth.uid)).data.role == "admin")
        || (exists(/databases/$(database)/documents/hackatonUsers/$(request.auth.uid))
          && get(/databases/$(database)/documents/hackatonUsers/$(request.auth.uid)).data.role == "admin")
      );
    }

    /** Admin or moderator — check-in desk, staff attendance. */
    function isOrganiser() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/io2026Hackathon_users/$(request.auth.uid))
          && get(/databases/$(database)/documents/io2026Hackathon_users/$(request.auth.uid)).data.role in ["admin", "moderator"])
        || (exists(/databases/$(database)/documents/hackatonUsers/$(request.auth.uid))
          && get(/databases/$(database)/documents/hackatonUsers/$(request.auth.uid)).data.role in ["admin", "moderator"])
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwnerOrAdmin(userId) {
      return isOwner(userId) || isAdmin();
    }

    match /hackatonUsers/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAdmin()
        || (isOwner(userId)
          && !("role" in request.resource.data && request.resource.data.role != resource.data.role)
          && !("deletedAt" in request.resource.data)
          && !("deletedBy" in request.resource.data));
      allow delete: if false;
    }

    match /hackatonProjects/{projectId} {
      allow read: if true;
      // Project creation goes through Cloud Function (createProject)
      // but we still allow direct create for backwards compat (place is stripped)
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && !("place" in request.resource.data && request.resource.data.place != null);
      // Only the project owner can update, and place cannot be set by clients
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && !("place" in request.resource.data && request.resource.data.place != resource.data.place)
        // Prevent hijacking ownership
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow delete: if isAuthenticated() &&
          (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    match /hackatonUsers/{userId}/bookmarks/{projectId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /hackatonDiscussions/{docId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() &&
        (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /hackatonUpdates/{docId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /hackatonConfig/{docId} {
      allow read: if true;
      // Write only through Cloud Functions (admin SDK bypasses rules)
      allow write: if false;
    }

    match /hackatonCreditClaims/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if false;
    }

    match /hackatonJoinRequests/{requestId} {
      // Anyone authenticated can read (needed to check own requests + project owner sees requests)
      allow read: if isAuthenticated();
      // Creation goes through Cloud Function, but allow direct create as fallback
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending";
      // No client-side status updates — only Cloud Function can approve/reject
      // Only allow withdrawal (delete) by the request creator while pending
      allow update: if false;
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && resource.data.status == "pending";
    }

    // Legacy live voting / attendance / winners (NEXT_PUBLIC_HACKATHON_DATASET unset)
    match /hackatonVotes/{voteId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.attendanceVerified == true;
      allow update, delete: if isAdmin();
    }
    match /hackatonAttendance/{attendanceId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId is string
        && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId)
      );
      allow delete: if isAdmin();
    }
    match /hackatonWinners/{winnerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hackatonBuddyRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.fromUserId != request.resource.data.toUserId;
      allow update: if isAuthenticated() && (
        (resource.data.toUserId == request.auth.uid && resource.data.status == "pending") ||
        isAdmin()
      );
      allow delete: if isAuthenticated()
        && resource.data.fromUserId == request.auth.uid
        && resource.data.status == "pending";
    }

    match /Interests/{tagId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    match /Expertise/{tagId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    match /TechStack/{tagId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Platform hackathon registry (metadata; Firestore data paths still follow dataset env)
    match /hackathons/{hackathonId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── IO 2026 live hackathon (NEXT_PUBLIC_HACKATHON_DATASET=io2026) ─────────────
    match /io2026Hackathon_users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAdmin()
        || (isOwner(userId)
          && !("role" in request.resource.data && request.resource.data.role != resource.data.role)
          && !("deletedAt" in request.resource.data)
          && !("deletedBy" in request.resource.data));
      allow delete: if false;
    }
    match /io2026Hackathon_users/{userId}/bookmarks/{projectId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    match /io2026Hackathon_projects/{projectId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && !("place" in request.resource.data && request.resource.data.place != null);
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && !("place" in request.resource.data && request.resource.data.place != resource.data.place)
        && !("voteTotal" in request.resource.data && request.resource.data.voteTotal != resource.data.voteTotal)
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow delete: if isAuthenticated() &&
          (resource.data.userId == request.auth.uid || isAdmin());
      }
    }
    match /io2026Hackathon_joinRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending";
      allow update: if false;
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && resource.data.status == "pending";
    }
    match /io2026Hackathon_votes/{voteId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      // Writes only via Cloud Functions (castVotes) — caps enforced server-side
      allow create, update, delete: if false;
    }
    match /io2026Hackathon_attendance/{attendanceId} {
      allow read: if isAuthenticated() && (isOrganiser() || resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /io2026Hackathon_settings/{docId} {
      allow read: if docId == "checkInPublic" || docId == "main" || docId == "liveSlide";
      allow create, update: if isAdmin() && docId in ["main", "liveSlide"]
        || isOrganiser() && docId == "checkInPublic";
      allow delete: if false;
    }
    match /io2026Hackathon_liveStats/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /io2026Hackathon_winners/{winnerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /io2026Hackathon_discussions/{docId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() &&
        (resource.data.authorId == request.auth.uid || isAdmin());
    }
    match /io2026Hackathon_updates/{docId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }
    match /io2026Hackathon_creditClaims/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if false;
    }
    match /io2026Hackathon_buddyRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.fromUserId != request.resource.data.toUserId;
      allow update: if isAuthenticated() && (
        (resource.data.toUserId == request.auth.uid && resource.data.status == "pending") ||
        isAdmin()
      );
      allow delete: if isAuthenticated()
        && resource.data.fromUserId == request.auth.uid
        && resource.data.status == "pending";
    }

    // ── IWD 2026 archive (read-only for clients; writes via Admin SDK / migration) ─
    match /iwd2026Hackathon_users/{userId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    match /iwd2026Hackathon_projects/{projectId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isAdmin();
      match /comments/{commentId} {
        allow read: if true;
        allow create, update: if false;
        allow delete: if isAdmin();
      }
    }
    match /iwd2026Hackathon_joinRequests/{requestId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    match /iwd2026Hackathon_votes/{voteId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    match /iwd2026Hackathon_attendance/{attendanceId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    match /iwd2026Hackathon_settings/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /iwd2026Hackathon_winners/{winnerId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isAdmin();
    }
    match /iwd2026Hackathon_discussions/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /iwd2026Hackathon_updates/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /iwd2026Hackathon_creditClaims/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }
    match /iwd2026Hackathon_buddyRequests/{requestId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
