# Cloud Functions (Gen 2) — point at IO 2026 collections when the app uses NEXT_PUBLIC_HACKATHON_DATASET=io2026
# Copy to .env in this folder for local emulator, or set the same keys in:
#   Firebase Console → Build → Functions → your function → Environment variables
#   (or Google Cloud Console → Cloud Run service for the function)

PROJECTS_COLLECTION=io2026Hackathon_projects
USERS_COLLECTION=io2026Hackathon_users
JOIN_REQUESTS_COLLECTION=io2026Hackathon_joinRequests
CONFIG_COLLECTION=io2026Hackathon_settings
CONFIG_DOC=main

ATTENDANCE_COLLECTION=io2026Hackathon_attendance
VOTES_COLLECTION=io2026Hackathon_votes
ACTIVE_HACKATHON_ID=io2026Hackathon
LIVE_STATS_COLLECTION=io2026Hackathon_liveStats
